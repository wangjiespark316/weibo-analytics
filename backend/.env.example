# =========================================================
# 微博智能分析平台 / AI 行业情报系统  环境变量样例
# 复制为 .env 并填入真实值；.env 不会被提交到 Git
# =========================================================

# ---------- 数据库（TiDB Cloud / MySQL，推荐用连接串）----------
# 形如 mysql://USER:PASSWORD@HOST:4000/DBNAME
DATABASE_URL=mysql://user:password@gateway01.xxx.tidbcloud.com:4000/weibo_ai
# TiDB Cloud Serverless 需要 CA 证书时填写路径
TIDB_CA_PATH=
# 也可改用分项配置（未设置 DATABASE_URL 时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=4000
MYSQL_USER=weibo_api
MYSQL_PASSWORD=
MYSQL_DATABASE=weibo_ai

# ---------- LLM（OpenAI 兼容 /chat/completions，默认 DeepSeek）----------
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-llm-key
LLM_MODEL=deepseek-chat

# ---------- 飞书（可选：AI 日报 / 销售晨报推送、多维表客户同步）----------
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_CHAT_ID=oc_xxxxxxxx
# 也可改用自定义机器人 Webhook（与应用凭证二选一）
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# 客户 CRM 多维表（用于销售驾驶舱客户同步），URL 中 /base/{APP_TOKEN}?table={TABLE_ID}
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ---------- 每日定时任务（北京时间）----------
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
# 是否在调度中执行微博采集（无采集器环境置 false）
ENABLE_CRAWL=false
REPORT_URL_TEMPLATE=https://your-domain/

# ---------- API 服务 ----------
PORT=8000
SERVICE_HOST=127.0.0.1
CACHE_TTL=300
API_CACHE_TTL=300
API_CACHE_MAX_SIZE=200
API_TIMEOUT=60
SENTIMENT_MAX_SAMPLE=5000
